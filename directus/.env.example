# Brick Engaged Directus Admin CMS
#
# Fill in your Supabase credentials to connect Directus to your existing database.
# You can find these values in your Supabase dashboard:
#   Project Settings → Database → Connection string → Parameters
#
# SUPABASE_DB_HOST - e.g. "aws-0-ap-southeast-1.pooler.supabase.com"
# SUPABASE_DB_PASSWORD - the database password you set when creating the project
# DIRECTUS_ADMIN_PASSWORD - a strong password for the admin account (dan@brickengaged.org)

SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
DIRECTUS_ADMIN_PASSWORD=
